# ─────────────────────────────────────────────────────────────────────────────
# Bússola dos Aspirantes — variáveis de ambiente (EXEMPLO)
#
# Copie este arquivo para `.env` (já ignorado pelo git) e preencha com os valores
# reais do SEU projeto Supabase. Use PROJETOS SEPARADOS para cada ambiente
# (desenvolvimento / homologação / produção) — nunca compartilhe o banco de prod
# com dev. Valores abaixo são fictícios.
#
# Regra de ouro: tudo que começa com PUBLIC_ vai para o navegador (não é segredo);
# o resto é segredo de servidor e NUNCA pode aparecer no bundle do cliente.
# ─────────────────────────────────────────────────────────────────────────────

# URL do projeto Supabase. Público (vai para o cliente).
PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Chave anônima (anon / public key). Público — NÃO é segredo (RLS protege os dados).
PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...sua-anon-key..."

# Chave service_role. ⚠️ SEGREDO CRÍTICO ⚠️
#  • Bypassa a RLS — trate como senha de administrador do banco.
#  • Só no servidor. NUNCA prefixe com PUBLIC_. NUNCA importe em código de cliente.
#  • Em produção, configure como variável de ambiente protegida no host (ex.: Vercel).
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...sua-service-role-key..."

# Origem pública da aplicação. Usada NO SERVIDOR para montar os links de
# verificação de e-mail e recuperação de senha (callback /auth/callback).
# Dev: http://localhost:4321  ·  Prod: https://seu-dominio.com
APP_URL="http://localhost:4321"
