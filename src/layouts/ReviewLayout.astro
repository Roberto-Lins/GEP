---
import BaseLayout from './BaseLayout.astro';
import ProgressoScript from '@components/estudo/ProgressoScript.astro';
import { cursoPorSlug } from '@utils/courses';

interface Props { curso: string; titulo: string; subtitulo?: string; kicker?: string }
const { curso, titulo, subtitulo, kicker = 'Revisão final' } = Astro.props;
const config = cursoPorSlug(curso);
---
<BaseLayout titulo={titulo} descricao={subtitulo} curso={curso}>
  <header class="mb-8">
    <div class="mb-2 flex items-center gap-2 text-sm">
      <a href={`/${curso}`} class="font-mono text-dourado/70 hover:text-dourado">{config?.titulo ?? curso}</a>
      <span class="text-nevoa/30">/</span>
      <span class="text-xs font-semibold uppercase tracking-[0.25em] text-dourado/80">{kicker}</span>
    </div>
    <h1 class="text-3xl font-bold sm:text-4xl">{titulo}</h1>
    {subtitulo && <p class="mt-3 max-w-2xl text-lg text-nevoa/80">{subtitulo}</p>}
  </header>
  <slot />
  <ProgressoScript curso={curso} totais={{}} />
</BaseLayout>
