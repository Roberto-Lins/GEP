---
import BaseLayout from './BaseLayout.astro';
import ProgressoScript from '@components/estudo/ProgressoScript.astro';

interface Props { titulo: string; subtitulo?: string; kicker?: string }
const { titulo, subtitulo, kicker = 'Revisão final' } = Astro.props;
---
<BaseLayout titulo={titulo} descricao={subtitulo}>
  <header class="mb-8">
    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.25em] text-dourado/80">{kicker}</p>
    <h1 class="text-3xl font-bold sm:text-4xl">{titulo}</h1>
    {subtitulo && <p class="mt-3 max-w-2xl text-lg text-nevoa/80">{subtitulo}</p>}
  </header>
  <slot />
  <ProgressoScript />
</BaseLayout>
