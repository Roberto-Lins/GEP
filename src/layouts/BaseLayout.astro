---
import '@styles/global.css';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import { cursoPorSlug } from '@utils/courses';

interface Props {
  titulo: string;
  descricao?: string;
  largura?: 'normal' | 'larga';
  /** slug do curso atual; quando ausente, é o dashboard (tema padrão) */
  curso?: string;
  /** override do tema visual (classe em themes.css); senão vem do curso */
  tema?: string;
}
const {
  titulo,
  descricao = 'Plataforma de estudos multi-curso — trilhas sequenciais com exercícios comentados.',
  largura = 'normal',
  curso,
  tema,
} = Astro.props;
const config = curso ? cursoPorSlug(curso) : undefined;
const temaAtivo = tema ?? config?.temaVisual ?? 'naval-command';
const PLATAFORMA = 'Bússola dos Aspirantes';
const tituloCompleto = titulo === PLATAFORMA ? titulo : `${titulo} · ${PLATAFORMA}`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descricao} />
    <meta name="generator" content={Astro.generator} />
    <title>{tituloCompleto}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0B1220" />
  </head>
  <body class={`tema-${temaAtivo}`}>
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-dourado focus:px-4 focus:py-2 focus:text-naval">
      Pular para o conteúdo
    </a>
    <Header curso={config} />
    <main id="conteudo" class={`mx-auto w-full px-4 py-8 sm:px-6 ${largura === 'larga' ? 'max-w-7xl' : 'max-w-6xl'}`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
