---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageContainer from '@components/layout/PageContainer.astro';
import CentralQuestoes from '@components/questoes/CentralQuestoes.tsx';
import ProgressoScript from '@components/estudo/ProgressoScript.astro';
import { todasQuestoes, totalQuestoes } from '@data/exercicios';
import { topicosEstudo } from '@data/timeline';
import { numeroTopico } from '@utils/slug';

const opcoes = [...topicosEstudo]
  .sort((a, b) => a.ordem - b.ordem)
  .map((t) => ({ slug: t.slug, titulo: t.titulo, numero: numeroTopico(t.slug) }));
const totalQ = totalQuestoes.multipla + totalQuestoes.vf + totalQuestoes.correlacione;
---
<BaseLayout titulo="Central de questões">
  <PageContainer
    kicker="Treino"
    titulo="Central de questões"
    subtitulo={`${totalQ} questões comentadas — ${totalQuestoes.multipla} de múltipla escolha, ${totalQuestoes.vf} de verdadeiro/falso e ${totalQuestoes.correlacione} correlações. Filtre por matéria e responda com gabarito imediato.`}
  />
  <CentralQuestoes questoes={todasQuestoes} topicos={opcoes} client:load />
  <ProgressoScript />
</BaseLayout>
