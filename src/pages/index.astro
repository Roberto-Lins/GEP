---
import BaseLayout from '@layouts/BaseLayout.astro';
import CourseDashboard from '@components/cursos/CourseDashboard.tsx';
import BackupProgresso from '@components/progresso/BackupProgresso.tsx';
import { listarCursos } from '@utils/courses';
import { dadosDoCurso } from '@utils/content';

const cursos = listarCursos().map((c) => {
  const dados = dadosDoCurso(c.slug);
  return {
    slug: c.slug,
    titulo: c.titulo,
    subtitulo: c.subtitulo,
    descricao: c.descricao,
    categoria: c.categoria,
    totalMaterias: dados ? dados.topicosEstudo.length : 0,
  };
});
---
<BaseLayout titulo="Bússola dos Aspirantes" largura="larga">
  <!-- HERO -->
  <section class="relative mb-12 overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-aco/40 via-naval-800 to-naval px-6 py-12 sm:px-10 sm:py-16">
    <div class="pointer-events-none absolute inset-0 opacity-[0.07]"
      style="background-image:radial-gradient(circle at 1px 1px, #D6A84F 1px, transparent 0);background-size:26px 26px"></div>
    <div class="relative max-w-2xl">
      <p class="mb-3 inline-flex items-center gap-2 rounded-full border border-dourado/30 bg-dourado/10 px-3 py-1 text-xs font-medium uppercase tracking-[0.2em] text-dourado">
        Campus de estudos
      </p>
      <h1 class="text-balance text-4xl font-bold leading-tight sm:text-5xl">Bússola dos Aspirantes</h1>
      <p class="mt-4 max-w-xl text-lg text-nevoa/85">
        Escolha um curso e siga a <strong class="text-marfim">trilha de estudo</strong> na ordem certa:
        aulas, resumos, mídias, exercícios comentados e revisão final — com o seu progresso salvo no
        navegador, sem login.
      </p>
    </div>
  </section>

  <!-- CURSOS -->
  <section class="mb-12">
    <h2 class="mb-5 text-2xl font-bold">Cursos disponíveis</h2>
    <CourseDashboard cursos={cursos} client:load />
  </section>

  <!-- BACKUP -->
  <section class="mb-4">
    <div class="card p-6">
      <h2 class="mb-1 font-serif text-xl text-marfim">Seu progresso</h2>
      <p class="mb-4 text-sm text-nevoa/70">
        Tudo fica salvo apenas neste navegador. Exporte um backup para guardar ou levar para outro
        dispositivo.
      </p>
      <BackupProgresso client:load />
    </div>
  </section>
</BaseLayout>
