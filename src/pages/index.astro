---
import BaseLayout from '@layouts/BaseLayout.astro';
import NavCard from '@components/cursos/NavCard.astro';
import BackupProgresso from '@components/progresso/BackupProgresso.tsx';
import ApoieVisual from '@components/apoie/ApoieVisual.astro';
import { ANOS, ANO_LABELS, contarMaterias, SEM_CONTEUDO } from '@utils/hierarchy';

const fmtMat = (n: number) => (n === 0 ? SEM_CONTEUDO : n === 1 ? '1 matéria' : `${n} matérias`);
const anos = ANOS.map((ano) => ({
  ano,
  label: ANO_LABELS[ano],
  meta: fmtMat(contarMaterias({ ano })),
  imagem: `/imagens/plataforma/anos/${ano}.webp`,
}));
---
<BaseLayout titulo="Bússola dos Aspirantes" largura="larga">
  <!-- APOIE (banner) -->
  <ApoieVisual variante="banner" />

  <!-- CERIMÔNIA DA ESPADA -->
  <section class="relative mb-12 overflow-hidden rounded-3xl border border-dourado/20 bg-naval-800 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.6)]">
    <img
      src="/imagens/plataforma/cerimonia-espada.webp"
      alt="Cerimônia da Espada da Escola Naval: aspirantes em formação e espadas de oficial sobre o tapete azul, com a bandeira do Brasil ao fundo"
      class="h-64 w-full object-cover object-center sm:h-80 lg:h-[26rem]"
      loading="lazy"
    />
    <!-- véu inferior para contraste do texto -->
    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-naval via-naval/75 to-transparent px-6 pb-6 pt-24 sm:px-10">
      <p class="mb-2 inline-flex items-center gap-2 rounded-full border border-dourado/30 bg-dourado/10 px-3 py-1 text-xs font-medium uppercase tracking-[0.2em] text-dourado">
        O objetivo
      </p>
      <h2 class="text-balance font-serif text-2xl font-bold leading-tight text-marfim sm:text-3xl">
        A Cerimônia da Espada
      </h2>
      <p class="mt-2 max-w-2xl text-sm text-nevoa/85 sm:text-base">
        Onde toda essa preparação deságua: o aspirante recebe a espada e se torna oficial da
        Marinha do Brasil. É por esse momento que vale cada trilha de estudo.
      </p>
    </div>
  </section>

  <!-- ANOS -->
  <section class="mb-12">
    <h2 class="mb-5 text-2xl font-bold">Escolha o ano</h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {anos.map(({ ano, label, meta, imagem }) => (
        <NavCard href={`/ano/${ano}`} titulo={label} meta={meta} imagem={imagem} cta="Abrir →" />
      ))}
    </div>
  </section>

  <!-- CONTRIBUIR -->
  <section class="mb-12">
    <a href="/adicionar-curso" class="card card-hover flex items-center gap-4 p-6">
      <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full border border-dourado/40 bg-dourado/10 text-2xl text-dourado">+</span>
      <span class="flex flex-col">
        <span class="font-serif text-xl text-marfim">Adicionar matéria</span>
        <span class="text-sm text-nevoa/70">Contribuir — monte um Course Kit e baixe o .zip para o mantenedor instalar.</span>
      </span>
    </a>
  </section>

  <!-- BACKUP -->
  <section class="mb-4">
    <div class="card p-6">
      <h2 class="mb-1 font-serif text-xl text-marfim">Seu progresso</h2>
      <p class="mb-4 text-sm text-nevoa/70">
        Tudo fica salvo apenas neste navegador. Exporte um backup para guardar ou levar para outro
        dispositivo.
      </p>
      <BackupProgresso client:load />
    </div>
  </section>
</BaseLayout>
