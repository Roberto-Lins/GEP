---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageContainer from '@components/layout/PageContainer.astro';
import BancoQuestoes from '@components/questoes/BancoQuestoes.tsx';
import ProgressoScript from '@components/estudo/ProgressoScript.astro';
import { multiplaEscolha, verdadeiroFalso, correlacionar } from '@data/exercicios';

const simulados = [
  { id: 'me', titulo: 'Simulado — Múltipla escolha', desc: `${multiplaEscolha.length} questões objetivas, no estilo da prova.`, questoes: multiplaEscolha },
  { id: 'vf', titulo: 'Simulado — Verdadeiro ou Falso', desc: `${verdadeiroFalso.length} afirmações para julgar.`, questoes: verdadeiroFalso },
  { id: 'cor', titulo: 'Simulado — Correlacione', desc: `${correlacionar.length} grupos de correlação.`, questoes: correlacionar },
];
---
<BaseLayout titulo="Simulados">
  <PageContainer
    kicker="Modo prova"
    titulo="Simulados"
    subtitulo="Treine por tipo de questão. Cada bloco mostra um placar ao vivo; seus acertos entram no progresso geral."
  />

  <nav class="mb-8 flex flex-wrap gap-2">
    {simulados.map((s) => (
      <a href={`#${s.id}`} class="chip border border-white/10 bg-white/5 text-nevoa/80 hover:border-dourado/40 hover:text-dourado">{s.titulo.replace('Simulado — ', '')}</a>
    ))}
  </nav>

  <div class="space-y-14">
    {simulados.map((s) => (
      <section id={s.id} class="scroll-mt-24">
        <div class="mb-5 border-l-4 border-dourado pl-4">
          <h2 class="text-2xl font-bold">{s.titulo}</h2>
          <p class="text-nevoa/70">{s.desc}</p>
        </div>
        <BancoQuestoes questoes={s.questoes} registrar={true} client:visible />
      </section>
    ))}
  </div>

  <ProgressoScript />
</BaseLayout>
