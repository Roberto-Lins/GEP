---
import { getCollection } from 'astro:content';
import ReviewLayout from '@layouts/ReviewLayout.astro';
import BlocoConceito from '@components/estudo/BlocoConceito.astro';
import BlocoPegadinha from '@components/estudo/BlocoPegadinha.astro';
import BlocoComparacao from '@components/estudo/BlocoComparacao.astro';
import BancoQuestoes from '@components/questoes/BancoQuestoes.tsx';
import BlocoEmBreve from '@components/estudo/BlocoEmBreve.astro';
import PlayerVideo from '@components/midia/PlayerVideo.astro';
import PlayerPodcast from '@components/midia/PlayerPodcast.astro';
import { listarCursos, cursoPorSlug } from '@utils/courses';
import { dadosDoCurso } from '@utils/content';
import { embaralhar } from '@utils/filtrarQuestoes';

export async function getStaticPaths() {
  return listarCursos().map((c) => ({ params: { curso: c.slug } }));
}

const { curso } = Astro.params;
const config = cursoPorSlug(curso!)!;
const dados = dadosDoCurso(curso!)!;

const mdxComponents = { BlocoConceito, BlocoPegadinha, BlocoComparacao };

const todas = await getCollection('cursos');
const secoes = todas
  .filter((e) => e.id.split('/')[0] === curso && e.id.split('/')[1] === '99-revisao-final')
  .sort((a, b) => a.data.secaoOrdem - b.data.secaoOrdem);
const pegar = (nome: string) => secoes.find((s) => s.data.secao === nome);
const renderizar = async (nome: string) => {
  const e = pegar(nome);
  return e ? (await e.render()).Content : null;
};

const MapaProva = await renderizar('mapa-da-prova');
const ResumoGeral = await renderizar('resumo-geral');
const ErrosFrequentes = await renderizar('erros-frequentes');
const RevisaoVespera = await renderizar('revisao-de-vespera');

// Simulado-relâmpago: amostra equilibrada com seed fixa (estável entre builds).
const simuladoRelampago = [
  ...embaralhar(dados.multiplaEscolha, 7).slice(0, 12),
  ...embaralhar(dados.verdadeiroFalso, 7).slice(0, 8),
  ...dados.correlacionar.slice(0, 2),
];
// Cursos com simulado próprio (variações, ex.: FAS) usam-no; os demais, o relâmpago.
const usaSimuladoFinal = !!(dados.simuladoFinal && dados.simuladoFinal.length > 0);
const simulado = usaSimuladoFinal ? dados.simuladoFinal! : simuladoRelampago;
const tituloSimulado = usaSimuladoFinal ? 'Simulado final' : 'Simulado-relâmpago';
const descSimulado = usaSimuladoFinal
  ? `${simulado.length} questões na forma da prova, distribuídas pelos pesos do professor.`
  : `${simulado.length} questões variadas dos temas mais prováveis.`;
// Mídias gerais (áudio/vídeo) reaproveitadas na revisão final (ex.: FAS).
const midiasGerais = dados.midiasGerais ?? [];
const videosGerais = midiasGerais.filter((m) => m.tipo === 'video');
const podcastsGerais = midiasGerais.filter((m) => m.tipo === 'podcast');

const navItens = [
  MapaProva && { id: 'mapa', label: 'Mapa da prova' },
  { id: 'simulado', label: tituloSimulado },
  midiasGerais.length > 0 && { id: 'midias', label: 'Áudio e vídeo' },
  ResumoGeral && { id: 'resumo-geral', label: 'Resumo geral' },
  ErrosFrequentes && { id: 'erros', label: 'Erros frequentes' },
  config.features.modoRevisaoVespera && RevisaoVespera && { id: 'vespera', label: 'Revisão de véspera' },
].filter(Boolean) as { id: string; label: string }[];
---
<ReviewLayout
  curso={curso}
  titulo="Revisão final"
  subtitulo="Simulado, erros frequentes e revisão de véspera. Concentre aqui as últimas horas antes da prova."
>
  <nav class="mb-10 flex flex-wrap gap-2">
    {navItens.map((n) => (
      <a href={`#${n.id}`} class="chip border border-white/10 bg-white/5 text-nevoa/80 hover:border-dourado/40 hover:text-dourado">{n.label}</a>
    ))}
    {config.features.simulados && (
      <a href={`/${curso}/simulados`} class="chip border border-dourado/30 bg-dourado/10 text-dourado-soft">Simulados completos →</a>
    )}
  </nav>

  {MapaProva && (
    <section id="mapa" class="scroll-mt-24 mb-14">
      <h2 class="mb-4 text-2xl font-bold">Mapa da prova</h2>
      <div class="prosa"><MapaProva components={mdxComponents} /></div>
    </section>
  )}

  <section id="simulado" class="scroll-mt-24 mb-14">
    <div class="mb-5 border-l-4 border-dourado pl-4">
      <h2 class="text-2xl font-bold">{tituloSimulado}</h2>
      <p class="text-nevoa/70">{simulado.length > 0 ? descSimulado : 'Simulado em construção.'}</p>
    </div>
    {simulado.length > 0 ? (
      <BancoQuestoes questoes={simulado} curso={curso} registrar={true} filtros={true} client:visible />
    ) : (
      <BlocoEmBreve tipo="questoes" titulo="Simulado em construção">
        O simulado deste curso será adicionado quando o banco de questões estiver pronto. Use, por
        enquanto, o mapa da prova, as perguntas-mãe e a revisão de véspera abaixo para treinar as
        respostas subjetivas.
      </BlocoEmBreve>
    )}
  </section>

  {midiasGerais.length > 0 && (
    <section id="midias" class="scroll-mt-24 mb-14">
      <h2 class="mb-4 text-2xl font-bold">Áudio e vídeo de revisão</h2>
      {videosGerais.length > 0 && (
        <div class="mb-6 grid gap-4 lg:grid-cols-2">{videosGerais.map((m) => <PlayerVideo midia={m} />)}</div>
      )}
      {podcastsGerais.length > 0 && (
        <div class="grid gap-4 sm:grid-cols-2">{podcastsGerais.map((m) => <PlayerPodcast midia={m} />)}</div>
      )}
    </section>
  )}

  {ResumoGeral && (
    <section id="resumo-geral" class="scroll-mt-24 mb-14">
      <h2 class="mb-4 text-2xl font-bold">Resumo geral</h2>
      <div class="prosa"><ResumoGeral components={mdxComponents} /></div>
    </section>
  )}

  {ErrosFrequentes && (
    <section id="erros" class="scroll-mt-24 mb-14">
      <h2 class="mb-4 text-2xl font-bold">Erros frequentes</h2>
      <div class="prosa"><ErrosFrequentes components={mdxComponents} /></div>
    </section>
  )}

  {config.features.modoRevisaoVespera && RevisaoVespera && (
    <section id="vespera" class="scroll-mt-24 mb-6">
      <h2 class="mb-4 text-2xl font-bold">Revisão de véspera</h2>
      <div class="prosa"><RevisaoVespera components={mdxComponents} /></div>
    </section>
  )}
</ReviewLayout>
