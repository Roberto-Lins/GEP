---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageContainer from '@components/layout/PageContainer.astro';
import BancoQuestoes from '@components/questoes/BancoQuestoes.tsx';
import ProgressoScript from '@components/estudo/ProgressoScript.astro';
import { listarCursos, cursoPorSlug } from '@utils/courses';
import { dadosDoCurso } from '@utils/content';

export async function getStaticPaths() {
  return listarCursos()
    .filter((c) => c.features.simulados)
    .map((c) => ({ params: { curso: c.slug } }));
}

const { curso } = Astro.params;
const config = cursoPorSlug(curso!)!;
const dados = dadosDoCurso(curso!)!;
type BlocoSimulado = {
  id: string;
  titulo: string;
  desc: string;
  questoes: import('@tipos/question').Questao[];
  duracaoMinutos?: number;
  pontos?: number;
  itens?: number;
  blueprint?: Array<{ bloco: string; pontos: number; objetivo: string }>;
  rubrica?: string[];
};

const simuladosNomeados: BlocoSimulado[] = (dados.simuladosCompletos ?? []).map((simulado) => ({
  ...simulado,
  desc: simulado.descricao,
}));

const simuladosGenericos = [
  { id: 'me', titulo: 'Simulado — Múltipla escolha', desc: `${dados.multiplaEscolha.length} questões objetivas, no estilo da prova.`, questoes: dados.multiplaEscolha },
  { id: 'vf', titulo: 'Simulado — Verdadeiro ou Falso', desc: `${dados.verdadeiroFalso.length} afirmações para julgar.`, questoes: dados.verdadeiroFalso },
  dados.correlacionar.length > 0 && { id: 'cor', titulo: 'Simulado — Correlacione', desc: `${dados.correlacionar.length} grupos de correlação.`, questoes: dados.correlacionar },
  dados.discursivas && dados.discursivas.length > 0 && { id: 'disc', titulo: 'Simulado — Discursivas', desc: `${dados.discursivas.length} questões discursivas com gabarito comentado e autoavaliação.`, questoes: dados.discursivas },
].filter(Boolean) as BlocoSimulado[];

const simulados = simuladosNomeados.length > 0 ? simuladosNomeados : simuladosGenericos;
const subtitulo = simuladosNomeados.length > 0
  ? `${simuladosNomeados.length} provas completas no formato da avaliação, com tempo, pontuação e espelho de correção.`
  : 'Treine por tipo de questão. Cada bloco mostra um placar ao vivo; seus acertos entram no progresso geral.';
const totais = Object.fromEntries(dados.timeline.map((t) => [t.slug, dados.checklistDe(t.slug).length]));
---
<BaseLayout titulo="Simulados" curso={curso}>
  <PageContainer
    kicker="Modo prova"
    titulo="Simulados"
    subtitulo={subtitulo}
  />

  <nav class="mb-8 flex flex-wrap gap-2">
    {simulados.map((s) => (
      <a href={`#${s.id}`} class="chip border border-white/10 bg-white/5 text-nevoa/80 hover:border-dourado/40 hover:text-dourado">{s.titulo.replace('Simulado — ', '')}</a>
    ))}
  </nav>

  <div class="space-y-14">
    {simulados.map((s) => (
      <section id={s.id} class="scroll-mt-24">
        <div class="mb-5 border-l-4 border-dourado pl-4">
          <h2 class="text-2xl font-bold">{s.titulo}</h2>
          <p class="text-nevoa/70">{s.desc}</p>
          {(s.duracaoMinutos || s.pontos) && (
            <div class="mt-3 flex flex-wrap gap-2">
              {s.duracaoMinutos && <span class="chip border border-white/10 bg-white/5 text-nevoa/80">{s.duracaoMinutos} min</span>}
              {s.pontos && <span class="chip border border-dourado/30 bg-dourado/10 text-dourado-soft">{s.pontos} pontos</span>}
              <span class="chip border border-white/10 bg-white/5 text-nevoa/80">
                {s.itens ? `${s.itens} itens em ${s.questoes.length} questões` : `${s.questoes.length} questões`}
              </span>
            </div>
          )}
        </div>
        {s.blueprint && (
          <div class="mb-5 overflow-x-auto rounded-xl border border-white/10">
            <table class="w-full min-w-[640px] text-left text-sm">
              <thead class="bg-white/5 text-dourado"><tr><th class="p-3">Bloco</th><th class="p-3">Pontos de treino</th><th class="p-3">Objetivo</th></tr></thead>
              <tbody>{s.blueprint.map((linha) => <tr class="border-t border-white/10"><td class="p-3 font-medium">{linha.bloco}</td><td class="p-3">{linha.pontos}</td><td class="p-3 text-nevoa/80">{linha.objetivo}</td></tr>)}</tbody>
            </table>
          </div>
        )}
        <BancoQuestoes questoes={s.questoes} curso={curso} registrar={true} permitirVerResposta={config.features.verRespostaAntes} client:visible />
        {s.rubrica && <ul class="mt-4 grid gap-2 text-sm text-nevoa/80 sm:grid-cols-2">{s.rubrica.map((item) => <li class="rounded-lg border border-white/10 bg-white/[.03] p-3">{item}</li>)}</ul>}
      </section>
    ))}
  </div>

  <ProgressoScript curso={curso} totais={totais} />
</BaseLayout>
