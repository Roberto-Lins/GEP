---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/cursos/Breadcrumb.astro';
import { Content, getHeadings } from '../../guias/criar-conteudos.md';

// Índice lateral: só as seções principais (## → depth 2).
const secoes = getHeadings().filter((h) => h.depth === 2);
---
<BaseLayout titulo="Guia — Como gerar os conteúdos" largura="larga">
  <Breadcrumb
    itens={[
      { label: 'Início', href: '/' },
      { label: 'Adicionar matéria', href: '/adicionar-curso' },
      { label: 'Guia de conteúdos' },
    ]}
  />

  <header class="mb-8">
    <span class="chip mb-3 inline-block border border-dourado/30 bg-dourado/10 text-[10px] uppercase tracking-wider text-dourado">
      Guia operacional
    </span>
    <h1 class="text-3xl font-bold sm:text-4xl">Como gerar os conteúdos de uma matéria</h1>
    <p class="mt-2 max-w-2xl text-nevoa/75">
      Da matéria bruta (fontes, slides, provas, áudios) à trilha pronta para a Bússola: linha do
      tempo, resumos, questões, áudios e vídeo — com os <strong class="text-marfim">prompts prontos</strong>
      de cada etapa.
    </p>

    <div class="mt-5 flex flex-wrap gap-3">
      <a href="/adicionar-curso" class="btn-ghost">← Voltar ao assistente</a>
      <a
        href="/arquivos/guia-criar-conteudos.docx"
        download
        class="btn-ghost"
      >
        ⬇ Baixar guia (.docx)
      </a>
    </div>
  </header>

  <div class="lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-10">
    <aside class="mb-8 lg:mb-0">
      <nav aria-label="Seções do guia" class="lg:sticky lg:top-6">
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-nevoa/50">Etapas</p>
        <ol class="space-y-1.5 text-sm">
          {secoes.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="link-quiet block leading-snug">{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>

    <article id="guia-conteudo" class="prosa max-w-3xl">
      <Content />
    </article>
  </div>

  <style is:global>
    /* Blocos de prompt copiáveis — escopo só na página do guia. */
    #guia-conteudo pre { position: relative; padding-top: 2.5rem; }
    #guia-conteudo pre .bloco-tag {
      position: absolute; top: 8px; left: 14px;
      font: 600 10px/1 'JetBrains Mono', monospace; letter-spacing: .08em;
      text-transform: uppercase; color: rgba(203,213,225,.55);
    }
    #guia-conteudo pre .bloco-copy {
      position: absolute; top: 7px; right: 8px;
      font: 600 11px/1 'JetBrains Mono', monospace;
      color: #0B1220; background: #D6A84F; border: none;
      padding: 5px 10px; border-radius: 7px; cursor: pointer;
      opacity: .85; transition: opacity .15s, background .15s;
    }
    #guia-conteudo pre:hover .bloco-copy { opacity: 1; }
    #guia-conteudo pre .bloco-copy:hover { background: #E0BD74; }
    #guia-conteudo pre .bloco-copy:focus-visible { opacity: 1; outline: 2px solid #F7F3EA; }
  </style>

  <script is:inline>
    (() => {
      const root = document.getElementById('guia-conteudo');
      if (!root) return;
      root.querySelectorAll('pre').forEach((pre) => {
        const code = pre.querySelector('code') || pre;
        const txt = code.innerText.trim();
        // Rótulo: prompt (vai pro ChatGPT/NotebookLM) vs. estrutura de pastas.
        const ehPrompt = /(^|\n)\s*#\s|Você é|Use (exclusivamente|somente)/.test(txt) || txt.length > 220;
        const tag = document.createElement('span');
        tag.className = 'bloco-tag';
        tag.textContent = ehPrompt ? 'Prompt — cole no ChatGPT / NotebookLM' : 'Estrutura';
        pre.appendChild(tag);

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'bloco-copy';
        btn.textContent = 'Copiar';
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(txt);
            btn.textContent = 'Copiado ✓';
          } catch {
            const r = document.createRange(); r.selectNodeContents(code);
            const s = getSelection(); s.removeAllRanges(); s.addRange(r);
            btn.textContent = 'Selecionado';
          }
          setTimeout(() => (btn.textContent = 'Copiar'), 1600);
        });
        pre.appendChild(btn);
      });
    })();
  </script>
</BaseLayout>
