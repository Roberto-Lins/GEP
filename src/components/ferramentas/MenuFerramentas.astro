---
// Popover "Ferramentas" do menu principal — lê o registro (zero JS além do dispatch do evento).
import { categorias, ferramentasPorCategoria } from '@tools/registry';
---

<details class="relative">
  <summary
    class="flex cursor-pointer list-none items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium text-nevoa transition hover:bg-white/5 hover:text-marfim"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4l-6 6a1.5 1.5 0 0 0 2.1 2.1l6-6a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.1-2.1z" />
    </svg>
    Ferramentas
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </summary>

  <div
    class="absolute right-0 z-50 mt-2 max-h-[70vh] w-72 overflow-auto rounded-xl border border-white/10 bg-naval-800 p-2 shadow-card"
  >
    {
      categorias.map((cat) => {
        const tools = ferramentasPorCategoria(cat.id);
        return (
          <div class="mb-1 last:mb-0">
            <div class="flex items-center gap-2 px-2 py-1 text-[11px] font-semibold uppercase tracking-wider text-dourado/70">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" set:html={cat.icone} />
              {cat.nome}
            </div>
            {tools.length === 0 ? (
              <p class="px-3 py-1 text-xs italic text-nevoa/40">Em breve</p>
            ) : (
              tools.map((t) =>
                t.status === 'disponivel' ? (
                  <div class="flex items-center justify-between gap-2 rounded-lg px-2 py-1.5 transition hover:bg-white/5">
                    <button
                      type="button"
                      data-abrir-ferramenta={t.id}
                      class="flex-1 text-left text-sm font-medium text-marfim"
                      title="Abrir em janela sobre a página atual"
                    >
                      {t.nome}
                    </button>
                    <a
                      href={t.rota}
                      class="shrink-0 rounded px-1.5 py-0.5 text-[10px] text-dourado/70 transition hover:bg-dourado/10 hover:text-dourado"
                      title="Abrir em tela cheia"
                    >
                      tela cheia ↗
                    </a>
                  </div>
                ) : (
                  <p class="px-3 py-1 text-xs text-nevoa/40">
                    {t.nome} <span class="italic">(em breve)</span>
                  </p>
                ),
              )
            )}
          </div>
        );
      })
    }
    <a
      href="/ferramentas"
      class="mt-1 block rounded-lg border-t border-white/10 px-3 py-2 text-center text-xs text-nevoa transition hover:text-dourado"
    >
      Ver todas as ferramentas
    </a>
  </div>
</details>

<script>
  // Abre a ferramenta em janela flutuante (o FerramentasHost escuta este evento).
  document.addEventListener('click', (e) => {
    const alvo = e.target as HTMLElement;
    const btn = alvo.closest<HTMLElement>('[data-abrir-ferramenta]');
    if (!btn) return;
    const id = btn.getAttribute('data-abrir-ferramenta');
    if (!id) return;
    window.dispatchEvent(new CustomEvent('bussola:abrir-ferramenta', { detail: { id } }));
    btn.closest('details')?.removeAttribute('open');
  });
</script>
