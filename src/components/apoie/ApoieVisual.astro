---
// Visualização "Apoie": avatar do Roberto sobre fundo de mar/navio + título.
// Reutilizado no banner do dashboard (variante "banner") e no topo da página
// /apoie (variante "hero").
interface Props {
  variante?: 'hero' | 'banner';
}
const { variante = 'hero' } = Astro.props;
const isBanner = variante === 'banner';

const FUNDO = '/imagens/plataforma/apoie-fundo-mar-navio.webp';
const AVATAR = '/imagens/plataforma/apoie-avatar-frente.webp';
---

<section
  class:list={[
    'relative overflow-hidden rounded-3xl border border-white/10 bg-naval-800',
    isBanner ? 'mb-12' : 'mb-10',
  ]}
>
  <!-- fundo de mar/navio -->
  <img
    src={FUNDO}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover opacity-60"
    loading={isBanner ? 'eager' : 'eager'}
  />
  <!-- véu para contraste do texto -->
  <div class="absolute inset-0 bg-gradient-to-r from-naval via-naval/80 to-naval/30"></div>
  <div class="pointer-events-none absolute inset-0 opacity-[0.07]"
    style="background-image:radial-gradient(circle at 1px 1px, #D6A84F 1px, transparent 0);background-size:26px 26px"></div>

  <div
    class:list={[
      'relative flex flex-col items-center gap-6 px-6 py-8 sm:flex-row sm:gap-8 sm:px-10',
      isBanner ? 'sm:py-8' : 'sm:py-12',
    ]}
  >
    <img
      src={AVATAR}
      alt="Avatar ilustrado do Roberto, oficial da Marinha, de quepe e sorrindo"
      class:list={[
        'shrink-0 object-contain drop-shadow-[0_10px_30px_rgba(0,0,0,0.5)]',
        isBanner ? 'h-32 w-32 sm:h-36 sm:w-36' : 'h-44 w-44 sm:h-56 sm:w-56',
      ]}
      loading="eager"
    />

    <div class="text-center sm:text-left">
      <p class="mb-3 inline-flex items-center gap-2 rounded-full border border-dourado/30 bg-dourado/10 px-3 py-1 text-xs font-medium uppercase tracking-[0.2em] text-dourado">
        Apoie a Bússola
      </p>
      <h2
        class:list={[
          'text-balance font-bold leading-tight text-marfim',
          isBanner ? 'text-2xl sm:text-3xl' : 'text-3xl sm:text-4xl',
        ]}
      >
        Apoie se eu consegui te apoiar
      </h2>
      <p class="mt-3 max-w-xl text-nevoa/85">
        A Bússola dos Aspirantes continua <strong class="text-marfim">gratuita para todos</strong>.
        Se você puder, uma contribuição voluntária de R$10 ajuda a custear as ferramentas de IA e
        acelerar a produção dos próximos cursos. 💛
      </p>

      {isBanner && (
        <a href="/apoie" class="btn btn-primary mt-5 inline-flex">
          Apoiar a Bússola →
        </a>
      )}
    </div>
  </div>
</section>
