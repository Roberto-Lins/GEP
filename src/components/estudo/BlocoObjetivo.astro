---
interface Props { titulo?: string }
const { titulo = 'Objetivo da etapa' } = Astro.props;
---
<aside class="my-6 rounded-xl border border-dourado/40 bg-dourado/[0.07] p-5 shadow-glow">
  <div class="mb-2 flex items-center gap-2 text-dourado">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4" fill="currentColor"/>
    </svg>
    <h3 class="font-serif text-lg font-semibold text-dourado">{titulo}</h3>
  </div>
  <div class="prosa text-marfim/90"><slot /></div>
</aside>
