---
import { dadosDoCurso } from '@utils/content';
import { numeroTopico, urlMateria } from '@utils/slug';

interface Props { curso: string }
const { curso } = Astro.props;
const dados = dadosDoCurso(curso)!;
const PRIORIDADE_META = dados.PRIORIDADE_META;
const checklistDe = dados.checklistDe;
const ordenada = [...dados.timeline].sort((a, b) => a.ordem - b.ordem);
---
<ol class="relative ml-3 border-l-2 border-white/10">
  {ordenada.map((t) => {
    const meta = PRIORIDADE_META[t.prioridade];
    const num = numeroTopico(t.slug);
    const total = checklistDe(t.slug).length;
    const revisao = t.ordem === 99;
    return (
      <li class="relative mb-6 pl-8" data-progresso-card={t.slug} data-total-checklist={total}>
        <span
          class:list={[
            'absolute -left-[11px] flex h-5 w-5 items-center justify-center rounded-full border-2 bg-naval',
            revisao ? 'border-dourado' : 'border-white/30',
          ]}
          data-progresso-ponto={t.slug}
        >
          <span class="h-2 w-2 rounded-full bg-white/30 transition-colors" data-progresso-ponto-fill={t.slug}></span>
        </span>

        <a href={urlMateria(curso, t.slug)} class="card card-hover block p-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-3">
              <span class="font-mono text-sm text-dourado/70">{revisao ? 'REV' : num}</span>
              <h3 class="font-serif text-lg font-semibold text-marfim">{t.titulo}</h3>
            </div>
            <span class:list={['chip border', meta.classe]}>{meta.label}</span>
          </div>
          <p class="mt-1 text-sm text-nevoa/70">{t.subtitulo}</p>
          <p class="mt-2 text-sm text-nevoa/85">{t.objetivo}</p>
          <div class="mt-3 flex items-center justify-between text-xs text-nevoa/60">
            <span class="inline-flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              {t.tempoEstimado}
            </span>
            <span data-progresso-rotulo={t.slug} class="font-medium">—</span>
          </div>
          <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/5">
            <div class="h-full rounded-full bg-progresso transition-all duration-500" style="width:0%" data-progresso-barra={t.slug}></div>
          </div>
        </a>
      </li>
    );
  })}
</ol>
