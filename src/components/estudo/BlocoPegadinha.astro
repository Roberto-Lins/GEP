---
interface Props { titulo?: string }
const { titulo = 'Pegadinha de prova' } = Astro.props;
---
<aside class="my-6 rounded-xl border-l-4 border-alerta border-y border-r border-y-alerta/20 border-r-alerta/20 bg-alerta/[0.07] p-5">
  <div class="mb-2 flex items-center gap-2 text-alerta">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>
    </svg>
    <h3 class="font-serif text-lg font-semibold text-alerta">{titulo}</h3>
  </div>
  <div class="prosa text-marfim/90"><slot /></div>
</aside>
