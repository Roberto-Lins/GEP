---
import { timeline } from '@data/timeline';
import { numeroTopico, urlMateria } from '@utils/slug';

interface Props { atual: string }
const { atual } = Astro.props;
const ordenada = [...timeline].sort((a, b) => a.ordem - b.ordem);
---
<nav class="sticky top-20 hidden max-h-[calc(100vh-6rem)] overflow-y-auto pr-2 lg:block" aria-label="Mini matérias">
  <p class="mb-3 px-2 text-xs font-semibold uppercase tracking-[0.2em] text-dourado/70">Trilha</p>
  <ol class="space-y-0.5">
    {ordenada.map((t) => {
      const ativo = t.slug === atual;
      const num = numeroTopico(t.slug);
      return (
        <li data-progresso-card={t.slug}>
          <a
            href={urlMateria(t.slug)}
            class:list={[
              'flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm transition',
              ativo ? 'bg-dourado/15 text-dourado' : 'text-nevoa/75 hover:bg-white/5 hover:text-marfim',
            ]}
            aria-current={ativo ? 'page' : undefined}
          >
            <span class:list={['font-mono text-xs', ativo ? 'text-dourado' : 'text-nevoa/40']}>{t.ordem === 99 ? 'R' : num}</span>
            <span class="flex-1 leading-tight line-clamp-1">{t.titulo}</span>
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-white/15" data-progresso-ponto-fill={t.slug}></span>
          </a>
        </li>
      );
    })}
  </ol>
</nav>
