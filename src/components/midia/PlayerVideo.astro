---
import type { Midia } from '@tipos/media';
interface Props { midia: Midia }
const { midia } = Astro.props;

// YouTube (ex.: vídeo não listado): embute via iframe em vez de <video>.
const ehYoutube = midia.origem === 'youtube';
const youtubeId = (src: string) => src.match(/(?:youtu\.be\/|v=|embed\/)([\w-]{11})/)?.[1] ?? src;
const ytId = ehYoutube ? youtubeId(midia.src) : '';

const ext = midia.src.split('.').pop()?.toLowerCase();
const mime = ext === 'webm' ? 'video/webm' : ext === 'mkv' ? 'video/x-matroska' : 'video/mp4';
const suportado = ext !== 'mkv';
---
<figure class="card overflow-hidden">
  {ehYoutube ? (
    <iframe
      class="aspect-video w-full bg-black"
      src={`https://www.youtube-nocookie.com/embed/${ytId}`}
      title={midia.titulo}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
    ></iframe>
  ) : suportado ? (
    <video controls preload="metadata" class="aspect-video w-full bg-black" poster={midia.thumb}>
      <source src={midia.src} type={mime} />
      Seu navegador não suporta vídeo.
    </video>
  ) : (
    <div class="flex aspect-video w-full flex-col items-center justify-center gap-2 bg-naval-700 text-center text-sm text-nevoa/70">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#D6A84F" stroke-width="1.6"><polygon points="5 3 19 12 5 21 5 3"/></svg>
      <span>Formato .mkv — baixe para assistir</span>
      <a href={midia.src} download class="text-dourado underline">Baixar vídeo</a>
    </div>
  )}
  <figcaption class="flex items-start justify-between gap-3 p-4">
    <div>
      <p class="font-serif text-marfim">{midia.titulo}</p>
      {midia.descricao && <p class="mt-1 text-sm text-nevoa/70">{midia.descricao}</p>}
      {ehYoutube && (
        <a
          href={midia.src}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-flex items-center gap-1 text-sm text-dourado underline-offset-4 hover:underline"
        >
          Abrir no YouTube
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
        </a>
      )}
    </div>
    <span class="chip shrink-0 border border-white/10 bg-white/5 text-xs text-nevoa/70">{midia.fonte}</span>
  </figcaption>
</figure>
