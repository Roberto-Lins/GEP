---
import type { CursoConfig } from '@tipos/course';
import { listingPathDoCurso } from '@utils/hierarchy';
import MenuFerramentas from '@components/ferramentas/MenuFerramentas.astro';
import { familiaDoCurso } from '@utils/courses';
import { formatarDuracaoModalidade, modalidadeNormalizada } from '@utils/study-modes';
import { dadosDoCurso } from '@utils/content';

interface Props { curso?: CursoConfig }
const { curso } = Astro.props;
const familia = curso ? familiaDoCurso(curso) : undefined;
const modalidades = familia && familia.modalidadesDisponiveis.length > 1
  ? familia.modalidadesDisponiveis.map((id) => familia.cursos[id]).filter(Boolean)
  : [];

// Dentro de um curso: caminho de "voltar uma instância" (a listagem onde o curso aparece).
const voltarHref = curso ? listingPathDoCurso(curso) : null;
const possuiSopas = curso ? Boolean(dadosDoCurso(curso.slug)?.sopasOficiais?.length) : false;

const PLATAFORMA = 'Bússola dos Aspirantes';

// Dentro de um curso: navegação do curso (respeitando features).
// No dashboard: marca da plataforma + link para os cursos.
const links = curso
  ? [
      { href: `/${curso.slug}`, label: 'Início' },
      curso.features.timeline && { href: `/${curso.slug}/timeline`, label: 'Timeline' },
      { href: `/${curso.slug}/questoes`, label: 'Questões' },
      curso.features.writing && { href: `/${curso.slug}/writing`, label: 'Writing' },
      curso.features.simulados && { href: `/${curso.slug}/simulados`, label: 'Simulados' },
      possuiSopas && { href: `/${curso.slug}/sopas`, label: 'SOPAs' },
      { href: `/${curso.slug}/revisao-final`, label: 'Revisão final' },
      { href: `/${curso.slug}/fontes`, label: 'Fontes' },
    ].filter(Boolean as unknown as (x: unknown) => x is { href: string; label: string })
  : [{ href: '/', label: 'Cursos' }];

const marca = curso ? curso.titulo : PLATAFORMA;
const sub = curso ? (curso.subtitulo ?? curso.categoria ?? '') : 'Plataforma de estudos';
const inicio = curso ? `/${curso.slug}` : '/';

const path = Astro.url.pathname;
const pathNorm = path.replace(/\/+$/, '') || '/'; // sem barra final

// Aba "Apoie": aparece sempre que NÃO se está no menu principal (dashboard "/")
// nem na própria página /apoie — ou seja, dentro de cursos, /ano/..., /ferramentas.
const mostrarApoie = pathNorm !== '/' && pathNorm !== '/apoie';
if (mostrarApoie) links.push({ href: '/apoie', label: 'Apoie' });

const ativo = (href: string) =>
  href === inicio ? path === href || path === `${href}/` : path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-naval/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={inicio} class="group flex items-center gap-3">
      <svg viewBox="0 0 32 32" class="h-9 w-9 shrink-0" aria-hidden="true">
        <circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" class="text-dourado" stroke-width="1.4" />
        <path d="M16 3v26M3 16h26" stroke="currentColor" class="text-dourado" stroke-width="0.9" opacity="0.5" />
        <path d="M16 7l2.8 6.2 6.2 2.8-6.2 2.8L16 25l-2.8-6.2L7 16l6.2-2.8z" fill="currentColor" class="text-aco" stroke="currentColor" stroke-width="1" />
        <circle cx="16" cy="16" r="2" fill="currentColor" class="text-dourado" />
      </svg>
      <span class="flex flex-col leading-tight">
        <span class="font-serif text-lg font-semibold text-marfim">{marca}</span>
        {sub && <span class="text-[11px] uppercase tracking-[0.2em] text-dourado/80">{sub}</span>}
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Principal">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'rounded-lg px-3 py-2 text-sm font-medium transition',
            ativo(l.href)
              ? 'bg-dourado/15 text-dourado'
              : 'text-nevoa hover:bg-white/5 hover:text-marfim',
          ]}
          aria-current={ativo(l.href) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}

      <MenuFerramentas curso={curso?.slug} />

      {curso && voltarHref && (
        <a
          href={voltarHref}
          class="ml-2 flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2 text-sm font-medium text-nevoa/70 transition hover:border-dourado/30 hover:bg-dourado/10 hover:text-dourado"
          title="Voltar à listagem desta matéria"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Voltar
        </a>
      )}

      {curso && (
        <a
          href="/"
          class="ml-1 flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2 text-sm font-medium text-nevoa/70 transition hover:border-dourado/30 hover:bg-dourado/10 hover:text-dourado"
          title="Voltar ao menu de cursos"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Bússola
        </a>
      )}
    </nav>

    <details class="relative md:hidden">
      <summary aria-label="Abrir menu principal" class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-white/10 text-marfim">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </summary>
      <div class="absolute right-0 mt-2 w-52 rounded-xl border border-white/10 bg-naval-800 p-2 shadow-card">
        {links.map((l) => (
          <a href={l.href} class:list={['block rounded-lg px-3 py-2 text-sm', ativo(l.href) ? 'bg-dourado/15 text-dourado' : 'text-nevoa hover:bg-white/5']}>
            {l.label}
          </a>
        ))}
        <a href="/ferramentas" class:list={['block rounded-lg px-3 py-2 text-sm', ativo('/ferramentas') ? 'bg-dourado/15 text-dourado' : 'text-nevoa hover:bg-white/5']}>
          Ferramentas
        </a>
        {curso && voltarHref && (
          <a href={voltarHref} class="mt-1 flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2 text-sm text-nevoa/70">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Voltar à listagem
          </a>
        )}
        {curso && (
          <a href="/" class="mt-1 flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2 text-sm text-nevoa/70">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Voltar à Bússola
          </a>
        )}
      </div>
    </details>
  </div>
  {curso && modalidades.length > 1 && (
    <nav
      class="border-t border-white/10 bg-naval-800/70"
      aria-label="Modalidade de estudo"
    >
      <div class="mx-auto flex max-w-7xl items-center gap-2 overflow-x-auto px-4 py-2 sm:px-6">
        <span class="mr-1 shrink-0 text-xs font-semibold uppercase tracking-[0.16em] text-nevoa/55">
          Modalidade de estudo
        </span>
        {modalidades.map((opcao) => {
          const meta = modalidadeNormalizada(opcao!);
          const atual = opcao!.slug === curso.slug;
          return (
            <a
              href={`/${opcao!.slug}`}
              class:list={[
                'shrink-0 rounded-lg border px-3 py-1.5 text-xs font-medium transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dourado',
                atual
                  ? 'border-dourado bg-dourado text-naval'
                  : 'border-white/15 bg-white/[0.03] text-nevoa hover:border-dourado/40 hover:text-dourado',
              ]}
              aria-current={atual ? 'page' : undefined}
            >
              {meta.rotulo}
              <span class:list={['ml-1 font-mono', atual ? 'text-naval/70' : 'text-nevoa/50']}>
                · {formatarDuracaoModalidade(meta.duracaoMinutos)}
              </span>
            </a>
          );
        })}
      </div>
    </nav>
  )}
</header>
