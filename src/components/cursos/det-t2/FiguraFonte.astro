---
import figurasDet from '@data/cursos/det-t2/figuras.json';
import manifestoNav4 from '@data/cursos/_familias/nav4-t2/figuras.json';

interface FiguraCatalogada {
  id: string;
  arquivo_fonte: string;
  localizacao: string;
  nivel_fidelidade: 'V1' | 'V2' | 'V3' | 'V4';
  arquivo_gerado: string;
  largura: number;
  altura: number;
  legenda: string;
  alt: string;
  leitura: string;
}
interface Props { figura: string }
const { figura } = Astro.props;
const figuras = [...figurasDet, ...manifestoNav4.figuras] as FiguraCatalogada[];
const item = figuras.find((entry) => entry.id === figura);
if (!item) throw new Error(`Figura não cadastrada: ${figura}`);
const rotuloFidelidade = {
  V1: 'Figura original',
  V2: 'Figura adaptada fielmente à fonte · V2',
  V3: 'Gráfico didático reconstruído a partir da fonte · V3',
  V4: 'Ilustração conceitual · V4',
}[item.nivel_fidelidade];
---
<figure class="figura-fonte not-prose" id={`fig-${figura}`}>
  <a class="imagem" href={item.arquivo_gerado} target="_blank" rel="noopener" aria-label={`Ampliar: ${item.legenda} (abre a imagem em outra aba)`}>
    <img src={item.arquivo_gerado} alt={item.alt} width={item.largura} height={item.altura} loading="lazy" decoding="async" />
    <span class="ampliar">Ampliar figura ↗</span>
  </a>
  <figcaption>
    <strong>{item.legenda}</strong>
    <p><b>Como ler:</b> {item.leitura}</p>
    <small>{rotuloFidelidade} · {item.arquivo_fonte} · {item.localizacao}</small>
  </figcaption>
</figure>
<style>
  .figura-fonte { margin: 1.8rem 0; border: 1px solid var(--border, #475569); border-radius: .8rem; overflow: hidden; }
  .imagem { display: block; position: relative; background: #080b10; text-decoration: none; }
  .imagem:focus-visible { outline: 3px solid #eab54d; outline-offset: -3px; }
  img { display: block; width: 100%; height: auto; max-height: 760px; object-fit: contain; margin: 0 auto; }
  .ampliar { display: block; padding: .6rem 1rem; color: #fff; background: #172235; font-size: .85rem; text-align: right; }
  .figura-fonte figcaption { color: #cbd5e1; text-align: left; margin: 0; padding: 1rem 1.2rem; line-height: 1.6; }
  figcaption strong { display: block; font-size: 1.05rem; }
  figcaption p { margin: .5rem 0; font-size: .95rem; }
  figcaption small { display: block; font-size: .78rem; opacity: .8; overflow-wrap: anywhere; }
  @media (max-width: 640px) { .figura-fonte figcaption { color: #cbd5e1; text-align: left; margin: 0; padding: .9rem; } img { max-height: none; } }
  @media print { .figura-fonte { break-inside: avoid; } .ampliar { display: none; } }
</style>
