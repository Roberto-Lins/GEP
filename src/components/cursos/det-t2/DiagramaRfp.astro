---
interface Props {
  tipo: 'cadeia' | 'ciclo' | 'formas' | 'linha' | 'circuito';
}

const { tipo } = Astro.props;

const legendas = {
  cadeia: 'Cadeia funcional do transmissor: cada bloco e a grandeza que determina.',
  ciclo: 'Ciclo temporal de carga da RFP e alimentação pulsada da magnetron.',
  formas: 'Comparação didática entre a descarga exponencial de um capacitor e o pulso retangular da RFP.',
  linha: 'Linha artificial representada como uma escada de indutores e capacitores.',
  circuito: 'Construção funcional do modulador tipo linha e problema resolvido por cada componente.',
} as const;
---

<figure class="rfp-diagrama not-prose" aria-label={legendas[tipo]}>
  {tipo === 'cadeia' && (
    <div class="cadeia" role="img" aria-label={legendas.cadeia}>
      <article class="bloco bloco-azul">
        <span class="numero">1</span>
        <small>manda disparar</small>
        <strong>Sincronizador</strong>
        <span class="resultado">determina a <b>FRP</b></span>
      </article>
      <span class="seta" aria-hidden="true">→</span>
      <article class="bloco bloco-ouro">
        <span class="numero">2</span>
        <small>aplica alta tensão</small>
        <strong>Modulador</strong>
        <span class="resultado">determina a <b>LP</b></span>
      </article>
      <span class="seta" aria-hidden="true">→</span>
      <article class="bloco bloco-verde">
        <span class="numero">3</span>
        <small>gera RF enquanto alimentado</small>
        <strong>Oscilador</strong>
        <span class="resultado">determina a <b>portadora</b></span>
      </article>
    </div>
  )}

  {tipo === 'ciclo' && (
    <div role="img" aria-label={legendas.ciclo}>
      <div class="metricas">
        <span><b>LP</b> 1 µs</span>
        <span><b>FRP</b> 1.000 Hz</span>
        <span><b>TRP</b> 1 ms</span>
        <span><b>ciclo ativo</b> 0,1%</span>
      </div>
      <div class="ciclo">
        <div class="ciclo-pulso"><span>magnetron ligada</span></div>
        <div class="ciclo-carga"><span>RFP recarrega · magnetron desligada</span></div>
      </div>
      <div class="ciclo-rotulos"><span>0</span><span>1 µs</span><span>1 ms</span></div>
      <p class="nota">A largura do trecho amarelo foi ampliada para ficar visível; a barra não está em escala.</p>
    </div>
  )}

  {tipo === 'formas' && (
    <div class="rolagem">
      <svg viewBox="0 0 900 330" role="img" aria-label={legendas.formas}>
        <g class="eixos">
          <path d="M70 255H410M70 255V55M490 255H830M490 255V55" />
        </g>
        <g class="rotulos">
          <text x="70" y="32">CAPACITOR ISOLADO</text>
          <text x="490" y="32">LINHA ARTIFICIAL (RFP)</text>
          <text x="235" y="305" text-anchor="middle">tempo</text>
          <text x="660" y="305" text-anchor="middle">tempo</text>
          <text x="38" y="160" transform="rotate(-90 38 160)" text-anchor="middle">tensão</text>
          <text x="458" y="160" transform="rotate(-90 458 160)" text-anchor="middle">tensão</text>
        </g>
        <path class="onda onda-ruim" d="M70 85 C120 88 130 128 170 157 S250 211 405 244" />
        <path class="onda onda-boa" d="M490 255 L510 86 L785 86 L805 255" />
        <g class="guias">
          <path d="M510 86V255M785 86V255" />
          <path d="M510 86H785" />
        </g>
        <g class="anotacoes">
          <text x="180" y="115">cai o tempo todo</text>
          <text x="180" y="139">sem patamar e sem corte</text>
          <text x="520" y="74">pórtico anterior</text>
          <text x="645" y="116" text-anchor="middle">patamar plano</text>
          <text x="800" y="74" text-anchor="end">pórtico posterior</text>
        </g>
      </svg>
    </div>
  )}

  {tipo === 'linha' && (
    <div class="rolagem">
      <svg viewBox="0 0 940 390" role="img" aria-label={legendas.linha}>
        <defs>
          <marker id="seta-ida-rfp" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
            <path d="M0 0L8 4L0 8Z" class="marcador marcador-ida" />
          </marker>
          <marker id="seta-volta-rfp" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
            <path d="M0 0L8 4L0 8Z" class="marcador marcador-volta" />
          </marker>
        </defs>
        <g class="fio">
          <path d="M85 170H130 M790 170H850" />
          <path d="M130 170h25l10-18 20 36 20-36 20 36 10-18h25" />
          <path d="M260 170h25l10-18 20 36 20-36 20 36 10-18h25" />
          <path d="M390 170h25l10-18 20 36 20-36 20 36 10-18h25" />
          <path d="M520 170h25l10-18 20 36 20-36 20 36 10-18h25" />
          <path d="M650 170h25l10-18 20 36 20-36 20 36 10-18h25" />
          <path d="M130 170V245 M260 170V245 M390 170V245 M520 170V245 M650 170V245 M790 170V245" />
          <path d="M112 245H148M112 260H148M242 245H278M242 260H278M372 245H408M372 260H408M502 245H538M502 260H538M632 245H668M632 260H668M772 245H808M772 260H808" />
          <path d="M130 260V290H790V260" />
        </g>
        <g class="rotulos">
          <text x="85" y="150" text-anchor="middle">chave</text>
          <text x="860" y="150" text-anchor="middle">ponta aberta</text>
          <text x="195" y="137" text-anchor="middle">L</text><text x="325" y="137" text-anchor="middle">L</text><text x="455" y="137" text-anchor="middle">L</text><text x="585" y="137" text-anchor="middle">L</text><text x="715" y="137" text-anchor="middle">L</text>
          <text x="130" y="235" text-anchor="middle">C</text><text x="260" y="235" text-anchor="middle">C</text><text x="390" y="235" text-anchor="middle">C</text><text x="520" y="235" text-anchor="middle">C</text><text x="650" y="235" text-anchor="middle">C</text><text x="790" y="235" text-anchor="middle">C</text>
        </g>
        <path class="trajeto ida" d="M120 78H800" marker-end="url(#seta-ida-rfp)" />
        <path class="trajeto volta" d="M800 112H120" marker-end="url(#seta-volta-rfp)" />
        <g class="anotacoes">
          <text x="455" y="62" text-anchor="middle">frente de descarga: ida T/2</text>
          <text x="455" y="100" text-anchor="middle">reflexão e volta T/2</text>
          <text x="455" y="340" text-anchor="middle">LP = T = tempo total de ida e volta</text>
        </g>
      </svg>
    </div>
  )}

  {tipo === 'circuito' && (
    <div class="circuito" role="img" aria-label={legendas.circuito}>
      <div class="circuito-fluxo">
        <article><small>energia de bordo</small><strong>Fonte</strong></article>
        <span aria-hidden="true">→</span>
        <article><small>evita perdas em calor</small><strong>Indutor L<sub>ch</sub></strong></article>
        <span aria-hidden="true">→</span>
        <article class="destaque"><small>acumula e forma o pulso</small><strong>RFP</strong></article>
        <span aria-hidden="true">→</span>
        <article><small>casa 50 Ω com 500 Ω</small><strong>Trafo de pulsos</strong></article>
        <span aria-hidden="true">→</span>
        <article><small>gera a portadora</small><strong>Magnetron</strong></article>
      </div>
      <div class="circuito-controle">
        <article><b>Diodo de carga</b><span>retém o pico e libera a escolha da FRP</span></article>
        <article><b>Thyratron / SCR</b><span>abre a descarga quando o sincronizador manda</span></article>
        <article><b>By-pass + L<sub>B</sub></b><span>escoa a carga invertida residual</span></article>
      </div>
      <p class="nota">Representação funcional simplificada: mostra o fluxo de energia e a função das peças; não substitui o esquema elétrico da fonte.</p>
    </div>
  )}

  <figcaption>
    <b>Reconstrução didática.</b> {legendas[tipo]}
  </figcaption>
</figure>

<style>
  .rfp-diagrama {
    margin: 1.5rem 0;
    overflow: hidden;
    border: 1px solid rgba(214, 168, 79, 0.24);
    border-radius: 1rem;
    background:
      radial-gradient(circle at top right, rgba(214, 168, 79, 0.09), transparent 34%),
      rgba(8, 20, 34, 0.82);
    color: #e7edf3;
  }

  figcaption {
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    padding: 0.75rem 1rem;
    color: rgba(231, 237, 243, 0.7);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  figcaption b { color: #d6a84f; }
  .rolagem { overflow-x: auto; padding: 0.5rem; }
  svg { display: block; width: 100%; min-width: 680px; height: auto; }
  .eixos path, .fio path { fill: none; stroke: rgba(231, 237, 243, 0.65); stroke-width: 2; vector-effect: non-scaling-stroke; }
  .rotulos { fill: rgba(231, 237, 243, 0.88); font-size: 16px; font-weight: 700; letter-spacing: 0.025em; }
  .anotacoes { fill: rgba(231, 237, 243, 0.72); font-size: 15px; }
  .onda { fill: none; stroke-width: 6; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .onda-ruim { stroke: #f87171; }
  .onda-boa { stroke: #d6a84f; }
  .guias path { fill: none; stroke: rgba(214, 168, 79, 0.35); stroke-width: 1; stroke-dasharray: 5 5; vector-effect: non-scaling-stroke; }
  .trajeto { fill: none; stroke-width: 3; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .ida { stroke: #60a5fa; }
  .volta { stroke: #d6a84f; }
  .marcador-ida { fill: #60a5fa; }
  .marcador-volta { fill: #d6a84f; }

  .cadeia {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: 0.65rem;
    padding: 1.25rem;
  }

  .bloco {
    position: relative;
    display: flex;
    min-height: 9.5rem;
    flex-direction: column;
    justify-content: center;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: .85rem;
    padding: 1.1rem;
    background: rgba(255,255,255,.035);
  }

  .bloco small, .bloco .resultado { color: rgba(231,237,243,.67); font-size: .78rem; line-height: 1.35; }
  .bloco strong { margin: .22rem 0 .65rem; color: #fff; font-size: 1.05rem; }
  .bloco .resultado { border-top: 1px solid rgba(255,255,255,.1); padding-top: .55rem; }
  .bloco .resultado b { color: #d6a84f; }
  .numero { position: absolute; top: .65rem; right: .7rem; color: rgba(255,255,255,.2); font-size: 1.5rem; font-weight: 800; }
  .bloco-azul { border-top: 3px solid #60a5fa; }
  .bloco-ouro { border-top: 3px solid #d6a84f; }
  .bloco-verde { border-top: 3px solid #4ade80; }
  .seta { align-self: center; color: #d6a84f; font-size: 1.5rem; }

  .metricas { display: grid; grid-template-columns: repeat(4, 1fr); gap: .55rem; padding: 1.25rem 1.25rem .85rem; }
  .metricas span { border: 1px solid rgba(255,255,255,.1); border-radius: .65rem; padding: .6rem .7rem; color: rgba(231,237,243,.75); font-size: .78rem; }
  .metricas b { display: block; color: #fff; font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; }
  .ciclo { display: flex; height: 4.5rem; margin: .2rem 1.25rem 0; overflow: hidden; border: 1px solid rgba(255,255,255,.12); border-radius: .75rem; }
  .ciclo-pulso, .ciclo-carga { display: flex; align-items: center; justify-content: center; padding: .5rem; text-align: center; font-size: .78rem; font-weight: 700; }
  .ciclo-pulso { width: 22%; min-width: 8rem; background: linear-gradient(135deg, #d6a84f, #f0cc75); color: #081422; }
  .ciclo-carga { flex: 1; background: repeating-linear-gradient(135deg, rgba(96,165,250,.12) 0 10px, rgba(96,165,250,.06) 10px 20px); color: rgba(231,237,243,.75); }
  .ciclo-rotulos { display: flex; justify-content: space-between; margin: .35rem 1.25rem 0; color: rgba(231,237,243,.58); font-size: .72rem; }
  .nota { margin: .65rem 1.25rem 1rem; color: rgba(231,237,243,.58); font-size: .74rem; line-height: 1.45; }

  .circuito { padding: 1.25rem 1.25rem .25rem; }
  .circuito-fluxo { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr auto 1fr; align-items: center; gap: .45rem; }
  .circuito-fluxo article { min-height: 6rem; border: 1px solid rgba(255,255,255,.12); border-radius: .75rem; padding: .8rem; background: rgba(255,255,255,.035); }
  .circuito-fluxo small { display: block; min-height: 2.2rem; color: rgba(231,237,243,.6); font-size: .68rem; line-height: 1.3; }
  .circuito-fluxo strong { color: #fff; font-size: .88rem; }
  .circuito-fluxo > span { color: #d6a84f; }
  .circuito-fluxo .destaque { border-color: rgba(214,168,79,.65); background: rgba(214,168,79,.11); }
  .circuito-controle { display: grid; grid-template-columns: repeat(3, 1fr); gap: .6rem; margin-top: .85rem; }
  .circuito-controle article { border-left: 3px solid #60a5fa; border-radius: .5rem; padding: .7rem .8rem; background: rgba(96,165,250,.07); }
  .circuito-controle b, .circuito-controle span { display: block; }
  .circuito-controle b { color: #bfdbfe; font-size: .78rem; }
  .circuito-controle span { margin-top: .22rem; color: rgba(231,237,243,.64); font-size: .7rem; line-height: 1.35; }

  @media (max-width: 760px) {
    .cadeia { grid-template-columns: 1fr; }
    .seta { transform: rotate(90deg); justify-self: center; }
    .metricas { grid-template-columns: repeat(2, 1fr); }
    .ciclo { height: 6rem; }
    .ciclo-pulso { min-width: 6.2rem; }
    .circuito-fluxo { grid-template-columns: 1fr; }
    .circuito-fluxo > span { justify-self: center; transform: rotate(90deg); }
    .circuito-fluxo article { min-height: 0; }
    .circuito-fluxo small { min-height: 0; margin-bottom: .25rem; }
    .circuito-controle { grid-template-columns: 1fr; }
  }
</style>
