{
  "name": "bussola-aspirantes",
  "type": "module",
  "version": "2.0.0",
  "description": "Bússola dos Aspirantes — plataforma estática multi-curso de estudos da Escola Naval",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-course": "node --import tsx scripts/create-course.ts",
    "validate-content": "node --import tsx scripts/validate-content.ts",
    "validate-sync": "node scripts/validate-skill-sync.mjs",
    "validate-math": "node scripts/validate-math.mjs",
    "validate-math:strict": "node scripts/validate-math.mjs --strict",
    "audit-media": "node --import tsx scripts/audit-media.ts",
    "audit-modalidades": "node --import tsx scripts/audit-study-modes.ts",
    "migrate-gep": "node --import tsx scripts/migrate-gep.ts",
    "gerar-pix": "node --import tsx scripts/gerar-pix.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^3.1.9",
    "@astrojs/react": "^3.6.3",
    "@astrojs/tailwind": "^5.1.4",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "astro": "^4.16.18",
    "jszip": "^3.10.1",
    "katex": "^0.16.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.19.21",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "ajv": "^8.20.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9"
  }
}
